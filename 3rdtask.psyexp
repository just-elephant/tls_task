        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="ЗАДАНИЕ НА ПРОСТРАНСТВЕННУЮ ПАМЯТЬ&amp;#10;&amp;#10;&amp;#10;На экране — 9 квадратов. &amp;#10;&amp;#10;Они будут по очереди загораться жёлтым.&amp;#10;&amp;#10;&amp;#10;Ваша задача — запомнить порядок,&amp;#10;в котором они загорались.&amp;#10;&amp;#10;&amp;#10;После короткой паузы кликните мышью&amp;#10;по квадратам в том же самом порядке.&amp;#10;&amp;#10;&amp;#10;Длина последовательности будет расти.&amp;#10;&amp;#10;Если не уверены — отвечайте наугад.&amp;#10;&amp;#10;&amp;#10;Старайтесь не двигать головой&amp;#10;и моргать между пробами, а не во время них.&amp;#10;&amp;#10;Нажмите ПРОБЕЛ, чтобы начать." valType="str" updates="constant" name="text"/>
