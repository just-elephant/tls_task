  <Flow>
    <Routine name="welcome_routine"/>
    <LoopInitiator loopType="TrialHandler" name="trials">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[OrderedDict([('sequence', '3-2'), ('span', np.int64(2)), ('trig_delay', np.int64(30))]), OrderedDict([('sequence', '5-2'), ('span', np.int64(2)), ('trig_delay', np.int64(30))]), OrderedDict([('sequence', '8-9-4'), ('span', np.int64(3)), ('trig_delay', np.int64(30))]), OrderedDict([('sequence', '7-4-1'), ('span', np.int64(3)), ('trig_delay', np.int64(30))]), OrderedDict([('sequence', '8-1-7-4'), ('span', np.int64(4)), ('trig_delay', np.int64(30))]), OrderedDict([('sequence', '7-1-6-4'), ('span', np.int64(4)), ('trig_delay', np.int64(30))]), OrderedDict([('sequence', '5-4-9-1-3'), ('span', np.int64(5)), ('trig_delay', np.int64(30))]), OrderedDict([('sequence', '1-9-8-6-5'), ('span', np.int64(5)), ('trig_delay', np.int64(30))]), OrderedDict([('sequence', '1-7-6-2-4-9'), ('span', np.int64(6)), ('trig_delay', np.int64(30))]), OrderedDict([('sequence', '9-4-7-8-6-2'), ('span', np.int64(6)), ('trig_delay', np.int64(30))]), OrderedDict([('sequence', '6-4-9-2-8-3-1'), ('span', np.int64(7)), ('trig_delay', np.int64(30))]), OrderedDict([('sequence', '7-2-8-6-3-1-5'), ('span', np.int64(7)), ('trig_delay', np.int64(30))])]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="corsi_conditions.csv" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="code"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="code"/>
      <Param name="name" updates="None" val="trials" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
