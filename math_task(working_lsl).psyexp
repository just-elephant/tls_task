        <Param val="Реши уравнение в уме.&amp;#10;&amp;#10;Появится СИНЯЯ цифра. Если это верный ответ — жми 'left key',&amp;#10;если нет — жми 'right key'.&amp;#10;&amp;#10;Отвечай быстро, но старайся не ошибаться.&amp;#10;Отвечать можно, пока цифра на экране и пока висит &quot;?&quot;.&amp;#10;&amp;#10;ПРОБЕЛ — начать" valType="str" updates="constant" name="text"/>
        <Param val="from exp settings" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
