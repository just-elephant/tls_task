        <Param val="sign_sent = False&amp;#10;win.callOnFlip(outlet.push_sample, [str(trig_eq)])" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="if eq_sign.status == STARTED and not sign_sent:&amp;#10;    win.callOnFlip(outlet.push_sample, ['12'])&amp;#10;    sign_sent = True" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if (((eq_sign.status === PsychoJS.Status.STARTED) &amp;&amp; (! sign_sent))) {&amp;#10;    psychoJS.window.callOnFlip(outlet.push_sample, [&quot;12&quot;]);&amp;#10;    sign_sent = true;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
